# ============================================================
# AseptiQ — .gitignore
# ============================================================

# --- Sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editores / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.vim/
.netrwhist

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Dependencias (si algún día agregas build) ---
node_modules/
.pnp
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Build / dist (si algún día agregas bundler) ---
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# --- Variables de entorno y secretos ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
secrets.json

# --- Supabase (si algún día usas CLI local) ---
supabase/.branches/
supabase/.temp/
supabase/.env

# --- Backups locales ---
# (los que vas creando manualmente durante las iteraciones)
backups/
*.bak
*.backup
*_old.*
*_copy.*

# --- Archivos temporales ---
*.tmp
*.temp
*.swp
*.orig
*.rej

# --- Otros ---
AseptiQ/
Backup/
CONTRATO_API.md
ProLog_v1.0/